# ====================================================================
# Whoopit Standard Inventory Management System (IMS)
# Environment Variables & Configuration
# ====================================================================

# --------------------------------------------------------------------
# 1. Backend Core API (Go 1.27)
# --------------------------------------------------------------------
APP_ENV=development
APP_PORT=8080
APP_NAME="Whoopit Inventory Platform"
LOG_LEVEL=info

# JWT Authentication & Symmetric Key
JWT_SECRET=whoopit_jwt_secret_2026_super_secure_auth_token_key_99
TOKEN_SYMMETRIC_KEY=whoopit_super_secret_32_byte_paseto_key_v4!

# Database Connection (PostgreSQL 18 with Row-Level Security)
DB_HOST=localhost
DB_PORT=5432
DB_USER=whoopit_admin
DB_PASSWORD=whoopit_secure_pw_2026
DB_NAME=whoopit_inventory_v4
DB_SSLMODE=disable
DATABASE_URL=postgres://whoopit_admin:whoopit_secure_pw_2026@localhost:5432/whoopit_inventory_v4?sslmode=disable

# Connection Pool Settings
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m

# Cache & Distributed Locking (Valkey 9 / Redis)
VALKEY_ADDR=localhost:6379
VALKEY_URL=valkey://localhost:6379
REDIS_URL=redis://localhost:6379/0

# Object Storage (SeaweedFS / S3 Compatible)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=any
S3_SECRET_KEY=any
S3_BUCKET=whoopit-documents
S3_USE_SSL=false

# Mailpit (Local SMTP / Email Testing)
SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_WEB_URL=http://localhost:8025
EMAIL_FROM=no-reply@whoopit.io

# ClamAV Antivirus Daemon
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=30s

# --------------------------------------------------------------------
# 2. Frontend Web Application (Next.js 16 App Router)
# --------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_DEFAULT_TENANT_ID=a0000000-0000-0000-0000-000000000001

# --------------------------------------------------------------------
# 3. Pre-Seeded Demo Credentials
# --------------------------------------------------------------------
# Admin User:  admin@whoopit.io / AdminPass123!  (Full permissions, financial valuation, product deletion)
# Staff User:  staff@whoopit.io / StaffPass123!  (Stock in/out, view & barcode print; valuation & cost masked)
